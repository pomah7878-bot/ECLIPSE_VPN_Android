<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates
                src="user"
                tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
    <!-- API магазина ECLIPSE: только HTTPS и только системные сертификаты
         (пользовательские CA и открытый HTTP для этого домена не допускаются). -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">eclipse.unlimited.bot.nu</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
